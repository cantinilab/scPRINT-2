  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## option 1\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "LOC = \"./\"\n",
    "a = pd.read_parquet(LOC + \"data/main/gene_locs/felis_catus.parquet\")\n",
    "b = pd.read_parquet(LOC + \"data/main/gene_locs/panthera_tigris_altaica.parquet\")\n",
    "a[\"organism\"] = \"NCBITaxon:9685\"\n",
    "b[\"organism\"] = \"NCBITaxon:74533\""
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "genedf = pd.concat([a, b])\n",
    "records = []\n",
    "prevorga = \"\"\n",
    "for k, v in genedf.iterrows():\n",
    "    if v[\"organism\"] != prevorga:\n",
    "        prevorga = v[\"organism\"]\n",
    "        organism = bt.Organism.filter(ontology_id=prevorga).one()\n",
    "    records.append(bt.Gene(ensembl_gene_id=k, organism=organism))\n",
    "ln.save(records)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# option B\n",
    "model.add_organism(\n",
    "    \"NCBITaxon:9685\",\n",
    "    emb=pd.read_parquet(LOC + \"data/main/gene_embs/catus_emb.parquet\"),\n",
    "    genes=a,\n",
    "    locs=a,\n",
    ")\n",
    "model.add_organism(\n",
    "    \"NCBITaxon:74533\",\n",
    "    emb=pd.read_parquet(LOC + \"data/main/gene_embs/tigris_emb.parquet\"),\n",
    "    genes=b,\n",
    "    locs=b,\n",
    ")"
   ]
  },
