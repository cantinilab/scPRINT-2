   "metadata": {},
   "outputs": [],
   "source": [
    "cat.obs[\"organism_ontology_term_id\"] = \"NCBITaxon:9685\"\n",
    "tiger.obs[\"organism_ontology_term_id\"] = \"NCBITaxon:74533\""
   ]
